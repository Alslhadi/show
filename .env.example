# انسخ هذا الملف إلى .env على جهازك/الخادم فقط. لا ترسله لأحد ولا ترفعه لـ GitHub.

# --- الدخول للوحة ---
DASHBOARD_TOKEN=ضع-كلمة-سر-طويلة-هنا

# --- مصدر البيانات ---
# SIMULATION = محاكاة للتجربة | MT5 = منصة MetaTrader 5 على هذا الجهاز | EXNESS = قيد الانتظار (يحتاج وثائق Exness الرسمية)
DATA_SOURCE=SIMULATION
SYMBOLS=XAUUSD,BTCUSD,EURUSD,GBPUSD
PAPER_BALANCE=100

# --- وضع التنفيذ: MANUAL | ASSISTED | SEMI_AUTO | AUTO ---
EXECUTION_MODE=AUTO

# --- MT5 (إذا كان حسابك التجريبي على MT5) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
# حسابات Exness قد تضيف حرفاً للرمز مثل XAUUSDm — راجع Market Watch
SYMBOL_SUFFIX=

# --- Exness API (عند توفر الوثائق) ---
EXN_API_KEY=
EXN_PRIVATE_KEY_PATH=
EXN_ACCOUNT_ID=

# --- الحساب الحقيقي: يبقى false حتى تقرر ---
LIVE_TRADING_ENABLED=false

# --- الاستراتيجية (سكالب هجومي) ---
TF_DOMINANT=H1
TF_CONFIRM=M15
TF_SETUP=M5
TF_ENTRY=M1
AUTO_MIN_SCORE=65
TP1_R=1.0
TP2_R=2.0
TP3_R=3.0
TRAILING_ATR=1.0
MAX_HOLD_MINUTES=240
CLOSE_BEFORE_WEEKEND=true

# --- المخاطر ---
RISK_PER_TRADE_PCT=3
MAX_RISK_PER_TRADE_PCT=5
DAILY_MAX_LOSS_PCT=15
WEEKLY_MAX_LOSS_PCT=30
MAX_DRAWDOWN_PCT=40
MAX_OPEN_TRADES=5
MAX_TRADES_PER_SYMBOL=2
MAX_CONSECUTIVE_LOSSES=5
NEWS_BLOCK_MINUTES=15
